{
  "name": "codex-ged",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .data",
    "backup": "node scripts/codex-backup.mjs create",
    "backup:list": "node scripts/codex-backup.mjs list",
    "backup:check": "node scripts/codex-backup.mjs check",
    "restore": "node scripts/codex-backup.mjs restore",
    "export": "node scripts/codex-export.mjs create",
    "export:check": "node scripts/codex-export.mjs check",
    "app": "bash desktop/build-app.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
