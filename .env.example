# URL of the Keystone app (project management), used by "Ouvrir dans Keystone".
NEXT_PUBLIC_KEYSTONE_URL=http://localhost:3000
# Where Codex keeps its local database and uploaded files (default: ./.data).
# CODEX_DATA_DIR=.data

# ── Integration API (docs/api.md) ──
# Bearer token of POST /api/import (migration tool). Unset: the import API is disabled (503).
# CODEX_IMPORT_TOKEN=change-me
# Maximum size of an imported file, in MB (default 100).
# CODEX_IMPORT_MAX_MB=100
# Bearer token of POST /api/integrations/vigie (Vigie decisions webhook). Unset: the webhook is disabled (503).
# VIGIE_WEBHOOK_TOKEN=change-me
# Vigie API; while unset, Vigie decisions can be simulated from Codex by a records manager.
# VIGIE_API_URL=http://localhost:3200/api
# URL of the Vigie app, used by "Ouvrir dans Vigie".
# NEXT_PUBLIC_VIGIE_URL=http://localhost:3200
