# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Secrets ──────────────────────────────────────────────
# env files (only the documented template is committed)
.env
.env.*
!.env.example
# keys and certificates
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
# credential and password stores
*.secret
*.secrets
secrets/
.secrets/
credentials.json
service-account*.json
*.kdbx
passwords.*
.npmrc
.netrc
# local Claude Code settings (may hold machine-specific permissions)
.claude/settings.local.json

# ── Dependencies ─────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ─────────────────────────────────────────
# next.js
/.next/
/out/
# production
/build
/dist
# desktop app (desktop/build-app.sh)
/desktop/dist
*.app
# typescript
*.tsbuildinfo
next-env.d.ts
# vercel
.vercel
# testing
/coverage

# ── Local data ───────────────────────────────────────────
# local database and uploaded files (PGlite)
/.data
# their backups (npm run backup, Administration; default CODEX_BACKUP_DIR)
/.data-backups
# design source archives (extracted in design/)
/*.zip

# ── Misc ─────────────────────────────────────────────────
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
